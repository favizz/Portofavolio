---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Favian's Portfolio",
  description = 'Portfolio of Favian Izza, a front-end developer crafting sleek, responsive, and user-friendly applications.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
