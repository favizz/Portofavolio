---
import { technology } from '../data/technology';
import { findTechRelation } from '../data/relations';
---

<section id="technology" class="section">
  <div class="relative z-10 flex w-full flex-col items-start text-left">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-accent" data-reveal>
      Technology
    </p>
    <h2 class="reveal section-heading mt-3" data-reveal>
      Languages, frameworks, and tools I reach for to ship full-stack systems.
    </h2>

    <div class="mt-12 flex w-full flex-wrap gap-3">
      {
        technology.map((tech) => {
          const relation = findTechRelation(tech.name);
          const Tag = relation ? 'button' : 'div';
          return (
            <Tag
              type={relation ? 'button' : undefined}
              class={`reveal group flex w-auto flex-none flex-col items-center gap-3 rounded-xl p-3 ${relation ? 'cursor-pointer' : 'cursor-default'}`}
              data-reveal
              data-open-section={relation ? relation.type : undefined}
              data-open-slug={relation ? relation.slug : undefined}
              title={relation ? `See in ${relation.type === 'project' ? 'Projects' : 'Career'}: ${relation.label}` : undefined}
              style={`--glow: ${tech.glow}`}
            >
              {tech.path ? (
                <svg
                  viewBox="0 0 24 24"
                  class="h-12 w-12 fill-current text-primary-light transition-colors group-hover:[color:var(--glow)]"
                >
                  <path d={tech.path} />
                </svg>
              ) : (
                <span class="flex h-12 w-12 items-center justify-center text-[18px] font-bold text-primary-light transition-colors group-hover:[color:var(--glow)]">
                  {tech.name}
                </span>
              )}
              <span class="text-[18px] text-text-muted">{tech.name}</span>
            </Tag>
          );
        })
      }
    </div>
  </div>
</section>
