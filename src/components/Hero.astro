---
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { certifications } from '../data/certifications';
import { achievements } from '../data/achievements';

const realProjects = projects.filter((p) => !('dummy' in p && p.dummy));
const realCerts = certifications.filter((c) => !('dummy' in c && c.dummy));

const mobileStats = [
  { number: `${realProjects.length}+`, label: 'Projects' },
  { number: `${experience.length}`, label: 'Experiences' },
  { number: `${realCerts.length}`, label: 'Certs' },
  { number: `${achievements.length}`, label: 'Achievements' },
];
---

<section id="home" class="section hero-section overflow-hidden">
  <div class="hero-photo-fixed hidden md:block" data-hero-photo>
    <img src="/images/profile-cutout.webp" alt="Portrait of Favian Izza" />
  </div>

  <!-- Mobile only (md:hidden): the desktop Hero above is the SideNav's own
       elements FLIP-morphed into place, which only exists md+ (the sidebar
       itself is hidden below that breakpoint). Below md this is its own,
       separate, simpler composition, not a shrunk copy of the desktop
       effect: a real heading (own scale, not the edge-to-edge wordmark),
       then the bio and stats, then the photo last, stacked as a normal
       block element beneath everything else. -->
  <div class="mobile-hero">
    <p class="mobile-hero-eyebrow reveal" data-reveal>Home</p>
    <h1 class="mobile-hero-heading reveal" data-reveal>FAVIAN</h1>
    <div class="mobile-hero-body reveal" data-reveal>
      <p class="mobile-hero-bio">
        {`Information Systems & Technology graduate from ITB, with   `}
        <span class="desc-emphasis">software engineering</span>
        {`   internship experience at two leading manufacturing companies.`}
      </p>
    </div>
    <div class="mobile-hero-stats reveal" data-reveal>
      {
        mobileStats.map((stat) => (
          <div class="mobile-stat">
            <p class="mobile-stat-num">{stat.number}</p>
            <p class="mobile-stat-label">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <img
      src="/images/profile-cutout.webp"
      alt="Portrait of Favian Izza"
      class="mobile-hero-photo reveal"
      data-reveal
    />
  </div>
</section>

<style>
  /* Explicit z-index, required once initHeroFlip's Hero pin exists
     (motion.ts): GSAP's pin mechanism sets this SECTION itself to
     `position: fixed` for the duration of the pin, without ever setting
     its own z-index (stays `auto`). `position: fixed` always creates a
     new stacking context regardless of z-index, so the photo's own
     `z-index: 6` below stopped being compared against the SIDEBAR's
     z-index: 4 directly, it got trapped inside THIS section's context,
     which as a whole then stacked as an auto/0-layer sibling below the
     sidebar's explicit, positive z-index: 4. Confirmed with
     elementFromPoint() at coordinates squarely inside the photo: FAVIAN's
     span was the topmost element there, painting in front of the photo
     despite the photo's own z-index reading 6 in isolation. A number
     bigger than the sidebar's 4 here (this section, not the photo, since
     the photo is what's actually trapped) fixes it regardless of whether
     Hero is currently pinned (position: static, where z-index has no
     effect) or mid-pin (position: fixed, where it does).
     */
  .hero-section {
    z-index: 5;
    /* Required once this got an explicit z-index (above): a positioned
       stacking context intercepts clicks for its ENTIRE bounding box
       before hit-testing considers anything painting through it, even at
       coordinates where the section itself has no visible content of its
       own (transparent background). This section's only real content is
       the photo, which already has its own pointer-events: none, and the
       mobile-only block below, which has none of its own interactive
       elements right now (re-enabled there defensively regardless, in
       case that changes). Without this, the section's now-elevated
       stacking context silently ate every click meant for anything
       visually overlapping Hero's screen area from elsewhere in the DOM,
       nav links and the Contact Me button included, confirmed directly
       with elementFromPoint(): clicking at a nav link's own coordinates
       hit-tested to this SECTION, not the link. */
    pointer-events: none;
  }

  .hero-photo-fixed {
    position: fixed;
    left: 50%;
    top: 10vh;
    bottom: 0;
    transform: translateX(-50%);
    z-index: 6;
    pointer-events: none;
  }

  /* Fixed, static 90vh (top:10vh + bottom:0), never JS-driven. FAVIAN
     behind it can be any size (it renders at z-index 0, below the photo's
     6, so it can never visually collide, whatever it overlaps just shows
     the photo on top), and the nav grid sits in the horizontal gap beside
     the photo (see initHeroFlip, motion.ts), so neither needs the photo's
     own position to make room for it. */

  .hero-photo-fixed img {
    height: 100%;
    width: auto;
    display: block;
  }

  /* display toggled here, in a real media query, rather than relying on a
     Tailwind `md:hidden` utility class on the element: Astro's scoped
     styles add a data-attribute selector that out-specifies a plain
     utility class regardless of source order, so `md:hidden` was silently
     losing to this block's own `display: flex` and both the mobile AND
     desktop Hero content were rendering at once. Confirmed via
     getComputedStyle at a desktop-width viewport reading `display: flex`
     here when it should have read `none`. */
  .mobile-hero {
    display: none;
    position: relative;
    z-index: 1;
    /* hero-section above is now pointer-events: none for click-passthrough
       reasons, re-enable it here so this block's own content (if it ever
       grows interactive elements) still receives clicks normally. */
    pointer-events: auto;
    height: 100%;
    width: 100%;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    /* No bottom inset: the photo (margin-top: auto below) is meant to
       touch the true bottom edge of the screen, a padding-bottom here
       would leave a gap instead. Top padding raised from 1rem to clear
       Header.astro's fixed mobile header (position: fixed, top: 0, a
       measured 72px tall: py-4 padding plus its h-10 toggle button),
       which otherwise overlapped this section's own top content, since
       a fixed header doesn't push normal document content down the way
       an in-flow one would. 5.5rem (88px) clears it with a little
       breathing room to spare. */
    padding: 5.5rem 1.25rem 0;
  }

  @media (max-width: 767px) {
    .mobile-hero {
      display: flex;
    }
  }

  .mobile-hero-eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .mobile-hero-heading {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.95;
    /* Its own scale, deliberately not the desktop wordmark shrunk down,
       a full-bleed edge-to-edge FAVIAN doesn't fit a narrow viewport's
       reading flow the way it can dominate a wide desktop screen. Raised
       across the board (2.5/15vw/3.5rem -> 2.75/16vw/4rem) per explicit
       "texts get bigger" feedback; the extra room it needs comes out of
       the gap/padding reductions below, not by shrinking anything else. */
    font-size: clamp(2.75rem, 16vw, 4rem);
    color: white;
  }

  .mobile-hero-body {
    /* Not flex: 1 1 auto: that stretched this block to fill all remaining
       vertical space regardless of its own (much shorter) content height,
       leaving a large dead gap between the bio paragraph and the stats
       row below. Sized to its own content, letting the wrapper's
       `justify-content: center` handle vertical centering of the group
       as a whole instead. */
    flex: 0 1 auto;
    /* A deliberately bigger gap specifically between FAVIAN and the bio,
       on top of .mobile-hero's own shared 0.6rem flex gap, per explicit
       request. The other transitions (eyebrow->heading, stats->photo)
       keep the tighter shared gap; only this one is called out. */
    margin-top: 1.5rem;
  }

  .mobile-hero-photo {
    display: block;
    /* Full width (the actual portrait is a 1:1 square, confirmed from the
       source file, so this renders exactly as wide as it is tall, not an
       arbitrary crop), maintaining its natural ratio rather than the
       previous 55%-wide/26vh-capped block. max-height is a safety net for
       unusually short viewports only: on any normal phone height, width:
       100% is the binding constraint (the square photo just isn't tall
       enough to hit 45vh at a mobile content column's width), so this
       doesn't fight "full width" in practice. */
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    max-height: 45vh;
    /* margin-top: auto (a flex child of .mobile-hero's column) consumes
       all remaining vertical space above the photo instead of centering
       it with the rest of the group, pinning it flush against the
       screen's true bottom edge (helped by .mobile-hero's own
       padding-bottom: 0 above) rather than sitting mid-screen with empty
       space below it, per explicit "touches the bottom of screen"
       request. Horizontal centering (left/right auto) is unaffected. */
    margin: auto auto 0;
  }

  .mobile-hero-bio {
    font-size: clamp(0.95rem, 4vw, 1.05rem);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
  }

  .mobile-hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .mobile-stat {
    text-align: center;
  }

  .mobile-stat-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.2rem, 5.5vw, 1.6rem);
    color: var(--color-accent);
  }

  .mobile-stat-label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.6);
  }
</style>
