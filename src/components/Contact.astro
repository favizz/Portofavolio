---
const inputClass =
  'w-full rounded-lg border border-primary-light/20 bg-primary-deep/40 px-4 py-3 text-sm text-white placeholder:text-text-muted/60 outline-none transition-colors focus:border-accent';
---

<section id="contact" class="section">
  <div class="flex w-full flex-col items-start text-left">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-accent" data-reveal>
      Contact
    </p>
    <h2 class="reveal section-heading mt-3" data-reveal>
      Have a project in mind or just want to say hello? Send me a message.
    </h2>

    <form id="contact-form" class="reveal mt-10 w-full" data-reveal>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="flex flex-col gap-2 text-left text-sm text-text-muted">
          Name
          <input
            type="text"
            name="name"
            required
            minlength="2"
            maxlength="80"
            placeholder="Your name"
            class={inputClass}
          />
        </label>
        <label class="flex flex-col gap-2 text-left text-sm text-text-muted">
          Email
          <input
            type="email"
            name="email"
            required
            maxlength="254"
            placeholder="you@example.com"
            class={inputClass}
          />
        </label>
      </div>
      <label class="mt-4 flex flex-col gap-2 text-left text-sm text-text-muted">
        Subject
        <input
          type="text"
          name="subject"
          required
          minlength="3"
          maxlength="120"
          placeholder="What is this about?"
          class={inputClass}
        />
      </label>
      <label class="mt-4 flex flex-col gap-2 text-left text-sm text-text-muted">
        Message
        <textarea
          name="message"
          required
          minlength="10"
          maxlength="2000"
          rows="5"
          placeholder="Your message"
          class={inputClass}
        ></textarea>
      </label>
      <button
        type="submit"
        class="btn-interactive mt-6 rounded-lg bg-primary-strong px-8 py-3.5 text-base font-semibold text-white"
      >
        Send Message
      </button>
      <p class="mt-3 text-xs text-text-muted/70">
        Sending opens a prefilled Gmail compose window addressed to me. Nothing is stored on this
        site.
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get('name') ?? '');
    const email = String(data.get('email') ?? '');
    const subject = String(data.get('subject') ?? '');
    const message = String(data.get('message') ?? '');

    const body = `Hi Favian,\n\n${message}\n\nFrom: ${name} (${email})`;
    const url =
      'https://mail.google.com/mail/?view=cm&fs=1&to=izza.diasputra10@gmail.com' +
      `&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    window.open(url, '_blank', 'noopener');
  });
</script>
