---
import { achievements } from '../data/achievements';
---

<section id="achievement" class="section">
  <div class="relative z-10 w-full">
    <div class="flex flex-col">
      <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-accent" data-reveal>
        Achievement
      </p>
      <h2 class="reveal section-heading mt-3" data-reveal>
        Awards and competition results earned along the way.
      </h2>
    </div>

    <div class="achievement-list reveal mt-6 flex w-full flex-col" data-reveal>
      {
        achievements.map((achievement) => (
          <div class="grid grid-cols-[1fr_auto] items-baseline gap-x-3 gap-y-1 border-b border-primary-light/10 py-4">
            <h3 class="card-title col-start-1 row-start-1 font-display font-semibold text-white">
              {achievement.short}
            </h3>
            <span class="col-start-2 row-start-1 text-sm text-text-muted">{achievement.date}</span>
            <p class="col-start-1 row-start-2 text-base text-text-muted">{achievement.org}</p>
            <a
              href={achievement.documentUrl}
              target="_blank"
              rel="noreferrer"
              class="text-cta col-start-2 row-start-2 justify-self-end text-sm"
            >
              <span class="hidden md:inline">View here</span>
              <span class="md:hidden" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
