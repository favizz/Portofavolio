---
import { achievements } from '../data/achievements';
---

<section id="achievement" class="section">
  <div class="flex w-full flex-col">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-accent" data-reveal>
      Achievement
    </p>
    <h2 class="reveal section-heading mt-3" data-reveal>
      Awards and competition results earned along the way.
    </h2>

    <div class="reveal mt-6 flex w-full flex-col" data-reveal>
      {
        achievements.map((achievement, index) => (
          <div class="group flex w-full items-baseline gap-5 border-b border-primary-light/10 px-2 py-3 transition-colors hover:bg-primary-light/5 md:gap-8">
            <span class="font-display text-base font-semibold text-accent/70">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="font-display text-xl font-semibold text-white transition-colors group-hover:text-accent md:text-2xl">
                {achievement.title}
              </h3>
              <p class="mt-1 text-base text-text-muted">{achievement.org}</p>
            </div>
            <span class="hidden text-sm text-text-muted sm:block">{achievement.date}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
