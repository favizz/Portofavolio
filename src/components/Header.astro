---
import { socials } from '../data/socials';

const links = [
  { id: 'career', label: 'Career' },
  { id: 'technology', label: 'Technology' },
  { id: 'project', label: 'Project' },
  { id: 'achievement', label: 'Achievement' },
  { id: 'certification', label: 'Certification' },
  { id: 'contact', label: 'Contact' },
];
---

<header
  id="mobile-header"
  class="mobile-header fixed top-0 inset-x-0 z-40 flex items-center justify-between gap-8 px-6 py-4 bg-primary-dark/70 backdrop-blur-md md:hidden"
>
  <a href="#home" class="relative z-40 font-display text-xl font-bold text-white">favian izza.</a>

  <button
    id="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Toggle menu"
    class="menu-toggle relative z-40 flex h-10 w-10 flex-col items-center justify-center gap-1.5"
  >
    <span class="menu-bar"></span>
    <span class="menu-bar"></span>
    <span class="menu-bar"></span>
  </button>
</header>

<div
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-30 flex flex-col items-center justify-center gap-10 bg-bg/95 backdrop-blur-lg md:hidden"
>
  <nav class="flex flex-col items-center gap-6">
    {
      links.map((link) => (
        <a
          href={`#${link.id}`}
          class="nav-link font-display text-2xl text-primary-light/80 transition-colors"
          data-section={link.id}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="mobile-menu-socials flex gap-5">
    {
      socials.map((social) => (
        <a
          href={social.url}
          target="_blank"
          rel="noreferrer"
          aria-label={social.label}
          class="btn-interactive flex h-11 w-11 items-center justify-center rounded-full bg-primary-deep text-primary-light hover:text-white"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current">
            <path d={social.path} />
          </svg>
        </a>
      ))
    }
  </div>

  <a
    href="/cv/Favian-Izza-CV.pdf"
    target="_blank"
    rel="noreferrer"
    download
    class="mobile-menu-cv btn-interactive inline-flex items-center justify-center rounded-lg bg-primary-strong px-6 py-3 text-sm font-semibold text-white"
  >
    Download CV
  </a>
</div>

<style>
  /* Idle-hide, mobile only (this header doesn't render at md+ at all):
     slides up and fades rather than just disappearing, per explicit
     "smoothly" request. transform, not display/visibility, so the
     transition actually has something to animate. Never hidden while the
     menu itself is open (see the script below), the toggle button has to
     stay reachable to close it. */
  .mobile-header {
    transition: transform 0.4s ease, opacity 0.4s ease;
  }

  .mobile-header.is-idle {
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  .menu-bar {
    width: 22px;
    height: 2px;
    border-radius: 999px;
    background: white;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded='true'] .menu-bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .mobile-menu {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Swapped based on which section is currently active (tracked globally
     in initActiveSection(), motion.ts, via document.body's
     data-active-section attribute, not a separate observer here): on the
     Home section the menu shows the social links, everywhere else it
     shows a Download CV button instead. Defaults (this compound selector
     not matching at all) to showing socials, which is correct both for
     data-active-section="home" AND for before the tracker's first update
     ever fires (e.g. very first paint, attribute doesn't exist yet). */
  .mobile-menu-cv {
    display: none;
  }

  :global(body[data-active-section]:not([data-active-section='home'])) .mobile-menu-socials {
    display: none;
  }

  :global(body[data-active-section]:not([data-active-section='home'])) .mobile-menu-cv {
    display: inline-flex;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const closeMenu = () => {
      menu.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      window.lenisInstance?.start();
    };

    const openMenu = () => {
      menu.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      window.lenisInstance?.stop();
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  // Idle-hide: any scroll or touch activity shows the header immediately
  // and resets a 2.2s countdown; once that expires with no further
  // activity, it hides (see .mobile-header.is-idle in the style block
  // above for the actual transition). Guarded against the menu being
  // open so the toggle button never disappears out from under a visitor
  // mid-interaction, and against a currently-focused header link (rare,
  // but hiding a focused element mid-keyboard-navigation would strand
  // it). window scroll, not Lenis, since Lenis mirrors its position onto
  // native scroll and this only needs to know "did anything happen",
  // not the exact position.
  const header = document.getElementById('mobile-header');
  if (header) {
    let idleTimer: ReturnType<typeof setTimeout>;
    const IDLE_MS = 2200;

    const showHeader = () => {
      header.classList.remove('is-idle');
    };

    const scheduleHide = () => {
      clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        const menuOpen = menu?.classList.contains('is-open');
        const focusInsideHeader = header.contains(document.activeElement);
        if (!menuOpen && !focusInsideHeader) {
          header.classList.add('is-idle');
        }
      }, IDLE_MS);
    };

    const onActivity = () => {
      showHeader();
      scheduleHide();
    };

    window.addEventListener('scroll', onActivity, { passive: true });
    window.addEventListener('touchstart', onActivity, { passive: true });
    window.addEventListener('pointerdown', onActivity);
    scheduleHide();
  }
</script>
