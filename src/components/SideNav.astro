---
import { projects } from '../data/projects';
import { experience } from '../data/experience';

const links = [
  { id: 'home', label: 'Home' },
  { id: 'about', label: 'About Me' },
  { id: 'academic', label: 'Academic' },
  { id: 'certification', label: 'Certification' },
  { id: 'project', label: 'Project' },
  { id: 'technology', label: 'Technology' },
  { id: 'career', label: 'Career' },
  { id: 'achievement', label: 'Achievement' },
  { id: 'contact', label: 'Contact' },
];

const realProjects = projects.filter((p) => !('dummy' in p && p.dummy));

const stats = [
  { number: `${realProjects.length}+`, label: 'Projects' },
  { number: `${experience.length}`, label: 'Experiences' },
];

const companies = experience.map((job) => ({ name: job.company, logo: job.logo }));
---

<nav
  data-side-nav
  class="fixed left-6 top-1/2 z-40 hidden max-h-[92vh] w-60 -translate-y-1/2 flex-col gap-1.5 overflow-y-auto lg:left-10 md:flex"
  aria-label="Section navigation"
>
  <div class="rounded-xl bg-primary-deep/60 px-4 py-2">
    <div class="flex items-center justify-between">
      <span class="font-display text-base font-bold text-white">Favian</span>
      <a
        href="tel:+6281289529832"
        aria-label="Call Favian"
        class="flex h-6 w-6 items-center justify-center rounded-full text-primary-light hover:text-white"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
          <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z" />
        </svg>
      </a>
    </div>
    <p class="mt-1 text-[11px] leading-snug text-primary-light/70">
      I like building things that ship, not just demos: backend APIs, IoT telemetry pipelines, and
      machine learning models written from scratch, then polished until they feel production
      ready.
    </p>
  </div>

  <div class="flex items-baseline gap-6 rounded-xl bg-primary-dark/60 px-4 py-2">
    {
      stats.map((stat) => (
        <div>
          <p class="font-display text-2xl font-bold text-white">{stat.number}</p>
          <p class="text-[10px] uppercase tracking-wide text-text-muted">{stat.label}</p>
        </div>
      ))
    }
  </div>

  <div class="flex flex-col items-start gap-0.5 rounded-xl bg-primary-strong/30 px-4 py-2">
    {
      links.map((link) => (
        <a
          href={`#${link.id}`}
          class="nav-link w-full rounded-lg px-2 py-0.5 text-sm font-medium tracking-wide text-primary-light/70 transition-colors hover:bg-primary-light/10 hover:text-white"
          data-section={link.id}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="overflow-hidden rounded-xl bg-primary-deep/60 px-4 py-2">
    <div class="marquee-track">
      {
        [...companies, ...companies].map((company) => (
          <span class="flex h-7 w-14 flex-shrink-0 items-center justify-center">
            <img
              src={company.logo}
              alt={company.name}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain"
            />
          </span>
        ))
      }
    </div>
  </div>

  <div class="rounded-xl bg-primary-dark/60 px-4 py-2">
    <a href="mailto:izza.diasputra10@gmail.com" class="text-cta text-xs">
      izza.diasputra10@gmail.com
    </a>
  </div>

  <a
    href="#contact"
    class="btn-interactive rounded-lg bg-primary-strong px-4 py-2 text-center text-sm font-semibold text-white"
  >
    Contact Me
  </a>
</nav>

<style>
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 16s linear infinite;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
