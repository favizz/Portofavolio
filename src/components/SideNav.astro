---
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { certifications } from '../data/certifications';
import { achievements } from '../data/achievements';

const links = [
  { id: 'career', label: 'Career' },
  { id: 'technology', label: 'Technology' },
  { id: 'project', label: 'Project' },
  { id: 'achievement', label: 'Achievement' },
  { id: 'certification', label: 'Certification' },
  { id: 'contact', label: 'Contact' },
];

const realProjects = projects.filter((p) => !('dummy' in p && p.dummy));
const realCerts = certifications.filter((c) => !('dummy' in c && c.dummy));

const stats = [
  { number: `${realProjects.length}+`, label: 'Projects' },
  { number: `${experience.length}`, label: 'Experiences' },
  { number: `${realCerts.length}`, label: 'Certs' },
  { number: `${achievements.length}`, label: 'Achievements' },
];

const companies = experience.map((job) => ({ name: job.company, logo: job.logo }));
---

<nav
  data-side-nav
  class="fixed left-2 top-1/2 z-[4] hidden w-[clamp(11rem,13vw,14rem)] -translate-y-1/2 flex-col gap-1.5 lg:left-3 md:flex"
  aria-label="Section navigation"
>
  <div class="nav-panel rounded-xl px-4 py-2" data-panel>
    <span class="font-display text-base font-bold uppercase leading-none text-black" data-morph="name">Favian</span>
    <p class="mt-1 text-[11px] leading-snug text-black/70" data-morph="desc">
      {`Information Systems & Technology graduate from ITB, with `}
      <br />
      <span class="desc-emphasis">software engineering</span>
      {` `}
      <br />
      {`internship experience at two leading manufacturing companies.`}
    </p>
  </div>

  <div class="nav-panel rounded-xl px-4 py-2" data-panel>
    <div data-morph="stats" class="overflow-hidden">
      <div class="marquee-track opacity-0" data-hero-fade>
        {
          [...stats, ...stats, ...stats].map((stat) => (
            <div class="flex flex-shrink-0 items-baseline gap-2 pr-6">
              <p class="font-display text-2xl font-bold">{stat.number}</p>
              <p class="text-[10px] uppercase tracking-wide opacity-60">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="nav-panel flex flex-col items-start gap-0.5 rounded-xl px-4 py-2" data-panel>
    {
      links.map((link) => (
        <a
          href={`#${link.id}`}
          class="nav-link rounded-lg px-2 py-0.5 text-sm font-medium tracking-wide text-black/70 transition-colors hover:bg-black/5 hover:text-black"
          data-section={link.id}
          data-morph-link={link.id}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="nav-panel overflow-hidden rounded-xl px-4 py-2 opacity-0" data-panel data-hero-fade>
    <div class="marquee-track">
      {
        [...companies, ...companies, ...companies].map((company) => (
          <span class="flex h-7 w-16 flex-shrink-0 items-center justify-center">
            <img
              src={company.logo}
              alt={company.name}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain"
            />
          </span>
        ))
      }
    </div>
  </div>

  <div class="nav-panel rounded-xl px-4 py-2 opacity-0" data-panel data-hero-fade>
    <button
      type="button"
      data-copy-email
      data-user="izza.diasputra10"
      data-domain="gmail.com"
      class="btn-interactive inline-block text-left text-xs font-medium text-black underline decoration-black/30 underline-offset-2 hover:decoration-black"
      title="Click to copy"
    ></button>
  </div>

  <a
    href="#contact"
    data-morph="contact"
    data-hero-fade
    class="btn-interactive rounded-lg bg-black px-4 py-2 text-center text-sm font-semibold text-white opacity-0"
  >
    Contact Me
  </a>
</nav>

<style>
  .nav-panel {
    background-color: transparent;
  }

  [data-side-nav] {
    scrollbar-width: none;
  }

  [data-side-nav]::-webkit-scrollbar {
    display: none;
  }

  /* No CSS animation here on purpose: the scrolling is driven by GSAP in
     initMarquees() (motion.ts). A CSS @keyframes version was silently
     disabled by `prefers-reduced-motion: reduce`, which is on far more
     often than it appears (Windows 11 sets it whenever "Show animations in
     Windows" is off, and it's forced on in automated browsers), so the
     marquees sat still for the user while every check of the markup looked
     correct. Three copies of the list are still rendered below, GSAP
     translates the track by exactly one third of its measured width to
     loop seamlessly. */
  .marquee-track {
    display: flex;
    width: max-content;
  }
</style>
