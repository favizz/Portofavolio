---
import { projects } from '../data/projects';
import { experience } from '../data/experience';
import { certifications } from '../data/certifications';
import { achievements } from '../data/achievements';

const links = [
  { id: 'home', label: 'Home' },
  { id: 'about', label: 'About Me' },
  { id: 'academic', label: 'Academic' },
  { id: 'certification', label: 'Certification' },
  { id: 'project', label: 'Project' },
  { id: 'technology', label: 'Technology' },
  { id: 'career', label: 'Career' },
  { id: 'achievement', label: 'Achievement' },
  { id: 'contact', label: 'Contact' },
];

const realProjects = projects.filter((p) => !('dummy' in p && p.dummy));
const realCerts = certifications.filter((c) => !('dummy' in c && c.dummy));

const stats = [
  { number: `${realProjects.length}+`, label: 'Projects' },
  { number: `${experience.length}`, label: 'Experiences' },
  { number: `${realCerts.length}`, label: 'Certs' },
  { number: `${achievements.length}`, label: 'Achievements' },
];

const companies = experience.map((job) => ({ name: job.company, logo: job.logo }));
---

<nav
  data-side-nav
  class="fixed left-2 top-1/2 z-[4] hidden w-[clamp(13rem,16vw,17rem)] -translate-y-1/2 flex-col gap-1.5 lg:left-3 md:flex"
  aria-label="Section navigation"
>
  <div class="nav-panel rounded-xl px-4 py-2" data-panel>
    <span class="font-display text-base font-bold uppercase text-black" data-morph="name">Favian</span>
    <p class="mt-1 text-[11px] leading-snug text-black/70" data-morph="desc">
      I like building things that ship, not just demos: backend APIs, IoT telemetry pipelines, and
      machine learning models written from scratch, then polished until they feel production
      ready.
    </p>
  </div>

  <div class="nav-panel overflow-hidden rounded-xl px-4 py-2" data-panel>
    <div data-morph="stats" class="overflow-hidden">
      <div class="marquee-track">
        {
          [...stats, ...stats].map((stat) => (
            <div class="flex flex-shrink-0 items-baseline gap-2 pr-6">
              <p class="font-display text-2xl font-bold">{stat.number}</p>
              <p class="text-[10px] uppercase tracking-wide opacity-60">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="nav-panel flex flex-col items-start gap-0.5 rounded-xl px-4 py-2" data-panel>
    {
      links.map((link) => (
        <a
          href={`#${link.id}`}
          class="nav-link w-full rounded-lg px-2 py-0.5 text-sm font-medium tracking-wide text-black/70 transition-colors hover:bg-black/5 hover:text-black"
          data-section={link.id}
          data-morph-link={link.id}
        >
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="nav-panel overflow-hidden rounded-xl px-4 py-2 opacity-0" data-panel data-hero-fade>
    <div class="marquee-track">
      {
        [...companies, ...companies].map((company) => (
          <span class="flex h-7 w-16 flex-shrink-0 items-center justify-center">
            <img
              src={company.logo}
              alt={company.name}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain"
            />
          </span>
        ))
      }
    </div>
  </div>

  <div class="nav-panel rounded-xl px-4 py-2 opacity-0" data-panel data-hero-fade>
    <button
      type="button"
      data-copy-email
      data-email="izza.diasputra10@gmail.com"
      class="text-left text-xs font-medium text-black underline decoration-black/30 underline-offset-2 hover:decoration-black"
      title="Click to copy"
    >
      izza.diasputra10@gmail.com
    </button>
  </div>

  <a
    href="#contact"
    data-morph="contact"
    class="btn-interactive rounded-lg bg-black px-4 py-2 text-center text-sm font-semibold text-white opacity-0"
    data-hero-fade
  >
    Contact Me
  </a>
</nav>

<style>
  .nav-panel {
    background-color: transparent;
  }

  [data-side-nav] {
    scrollbar-width: none;
  }

  [data-side-nav]::-webkit-scrollbar {
    display: none;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 16s linear infinite;
  }

  @keyframes marquee {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>
