---
import { education } from '../data/education';
---

<section id="academic" class="section">
  <div class="flex w-full flex-col">
    <h2 class="reveal section-heading" data-reveal>Academic</h2>
    <p class="reveal section-desc" data-reveal>
      Formal education behind the systems I build.
    </p>

    <div
      class="academic-grid reveal mt-6 w-full"
      data-reveal
      data-expand-grid
      data-list
      data-expand-section="academic"
    >
      <div data-expand-carousel>
        {
          education.map((entry) => (
            <button type="button" class="carousel-item" data-carousel-item data-slug={entry.slug}>
              {entry.short}
            </button>
          ))
        }
      </div>
      <div data-expand-stage></div>
      <div class="contents" data-expand-default>
        {
          education.map((entry, index) => (
            <article
              class={`expand-card group w-full border-b border-primary-light/10 transition-colors hover:bg-primary-light/5 ${entry.pending ? 'opacity-60' : ''}`}
              data-expand-card
              data-slug={entry.slug}
              tabindex="0"
              role="button"
              aria-label={`Open ${entry.school} details`}
            >
              <div class="card-face flex w-full items-baseline gap-5 px-2 py-6 md:gap-8">
                <span class="font-display text-base font-semibold text-accent/70">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0 flex-1">
                  <h3 class="font-display text-3xl font-semibold text-white transition-colors group-hover:text-accent md:text-3xl">
                    {entry.school}
                  </h3>
                  <p class="mt-1 text-base text-text-muted">{entry.degree}</p>
                </div>
                <span class="hidden text-sm text-text-muted sm:block">{entry.period}</span>
              </div>

              <div class="stage-media flex items-center justify-center bg-white p-10">
                <img
                  src={entry.image}
                  alt={`${entry.school} logo`}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-contain"
                />
              </div>

              <div class="card-detail relative z-10 w-full flex-1 p-6">
                <button
                  class="btn-interactive absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-bg/80 text-lg text-white backdrop-blur"
                  data-expand-back
                  data-expand-ignore
                  aria-label="Return to academic overview"
                >
                  <span class="back-arrow-icon" aria-hidden="true"></span>
                </button>

                <h3 class="max-w-xl font-display text-3xl font-semibold text-white">
                  {entry.school}
                </h3>
                <p class="mt-1 text-sm font-medium text-accent">{entry.degree}</p>
                {entry.period && <span class="mt-1 text-base text-text-muted">{entry.period}</span>}
                {entry.gpa && <p class="mt-2 text-sm font-medium text-accent">GPA {entry.gpa}</p>}
                {
                  entry.pending && (
                    <p class="mt-2 max-w-md text-sm text-text-muted">
                      This entry is waiting on real details: school name, city, and years
                      attended.
                    </p>
                  )
                }
                {
                  entry.coursework.length > 0 && (
                    <div class="mt-4 flex max-w-xl flex-wrap gap-2">
                      {entry.coursework.map((course) => (
                        <span class="rounded-full border border-primary-light/20 px-2 py-0.5 text-[11px] text-primary-light">
                          {course}
                        </span>
                      ))}
                    </div>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Expanded academic entry: logo media left column, description fills the
     remaining space, matching the Projects/Career expanded layout. */
  .academic-grid :global([data-expand-stage] .expand-card) {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    background: color-mix(in srgb, var(--color-primary-deep) 40%, transparent);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .academic-grid :global([data-expand-stage] .expand-card .stage-media) {
    width: 40%;
    max-width: 340px;
    flex-shrink: 0;
  }

  .academic-grid :global([data-expand-stage] .expand-card .card-detail) {
    flex: 1 1 auto;
  }

  @media (max-width: 640px) {
    .academic-grid :global([data-expand-stage] .expand-card) {
      flex-direction: column;
    }

    .academic-grid :global([data-expand-stage] .expand-card .stage-media) {
      width: 100%;
      max-width: none;
      aspect-ratio: 16 / 9;
    }
  }
</style>
