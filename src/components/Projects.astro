---
import { projects } from '../data/projects';
---

<section id="project" class="section">
  <div class="relative z-10 flex w-full flex-col">
    <h2 class="reveal font-display text-6xl font-bold text-accent md:text-7xl" data-reveal>
      Projects
    </h2>
    <p class="reveal mt-5 max-w-2xl text-justify text-2xl text-text-muted md:text-3xl" data-reveal>
      Selected builds spanning IoT telemetry, full-stack platforms, and machine learning written
      from scratch.
    </p>

    <div
      class="project-grid reveal mt-6 w-full"
      data-reveal
      data-expand-grid
      data-hscroll
      data-expand-section="project"
    >
      <div data-expand-carousel>
        {
          projects.map((project) => (
            <button type="button" class="carousel-item" data-carousel-item data-slug={project.slug}>
              {project.name}
            </button>
          ))
        }
      </div>
      <div data-expand-stage></div>
      <div data-expand-default>
        {
          projects.map((project, index) => (
            <article
              class="expand-card group w-[270px] flex-shrink-0 md:w-[340px]"
              data-expand-card
              data-slug={project.slug}
              tabindex="0"
              role="button"
              aria-label={`Open ${project.name} details`}
            >
              <div class="card-face">
                <div class="hover-border relative aspect-[16/10] w-full overflow-hidden rounded-xl">
                  <img
                    src={project.image}
                    alt={`${project.name} preview`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="mt-3 flex items-baseline gap-3">
                  <span class="font-display text-base font-semibold text-accent/70">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 class="min-w-0 flex-1 font-display text-3xl font-semibold text-white transition-colors group-hover:text-accent">
                    {project.name}
                  </h3>
                  <span class="text-sm text-text-muted">{project.period}</span>
                </div>
                <p class="mt-1 pl-8 text-base text-text-muted">{project.tag}</p>
              </div>

              <div class="stage-media">
                <img
                  src={project.image}
                  alt={`${project.name} preview`}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>

              <div class="card-detail relative flex-1 p-6">
                <button
                  class="btn-interactive absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-bg/80 text-lg text-white backdrop-blur"
                  data-expand-back
                  data-expand-ignore
                  aria-label="Return to all projects"
                >
                  <span class="back-arrow-icon" aria-hidden="true"></span>
                </button>
                <span class="text-sm font-semibold uppercase tracking-wide text-accent">
                  {project.tag}
                </span>
                <h3 class="mt-1 font-display text-3xl font-semibold text-white">{project.name}</h3>
                <span class="mt-1 text-sm text-text-muted">{project.period}</span>
                <p class="mt-4 max-w-xl text-base text-text-muted">{project.description}</p>
                <ul class="mt-3 max-w-md list-disc space-y-1 pl-5 text-sm text-text-muted">
                  {project.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
                <div class="mt-3 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="rounded-full border border-primary-light/20 px-2 py-0.5 text-[11px] text-primary-light">
                      {tag}
                    </span>
                  ))}
                </div>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noreferrer"
                  data-expand-ignore
                  class="text-cta mt-5 text-sm"
                >
                  Visit site <span aria-hidden="true">&#8594;</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Expanded project: image left column, description right column. */
  .project-grid :global([data-expand-stage] .expand-card) {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    background: color-mix(in srgb, var(--color-primary-deep) 40%, transparent);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .project-grid :global([data-expand-stage] .expand-card .stage-media) {
    width: 40%;
    max-width: 340px;
    flex-shrink: 0;
  }

  .project-grid :global([data-expand-stage] .expand-card .card-detail) {
    flex: 1 1 auto;
  }

  @media (max-width: 640px) {
    .project-grid :global([data-expand-stage] .expand-card) {
      flex-direction: column;
    }

    .project-grid :global([data-expand-stage] .expand-card .stage-media) {
      width: 100%;
      max-width: none;
      aspect-ratio: 16 / 9;
    }
  }
</style>
