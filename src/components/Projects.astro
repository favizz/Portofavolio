---
import { projects } from '../data/projects';
---

<section id="project" class="section">
  <div class="relative z-10 flex w-full flex-col">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-accent" data-reveal>
      Projects
    </p>
    <h2 class="reveal section-heading mt-3" data-reveal>
      IoT, full-stack, and machine learning builds.
    </h2>

    <div
      class="reveal mt-6 w-full"
      data-reveal
      data-expand-grid
      data-hscroll
      data-expand-section="project"
    >
      <div data-expand-carousel>
        {
          projects.map((project) => (
            <button type="button" class="carousel-item" data-carousel-item data-slug={project.slug}>
              {project.name}
            </button>
          ))
        }
      </div>
      <div class="carousel-nav-mobile" data-carousel-nav>
        <button type="button" class="carousel-nav-btn" data-carousel-prev aria-label="Previous project">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5 8 12l7 7" fill="none" stroke="black" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15 5 8 12l7 7" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="carousel-nav-btn" data-carousel-next aria-label="Next project">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5l7 7-7 7" fill="none" stroke="black" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M9 5l7 7-7 7" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <div data-expand-default>
        {
          projects.map((project) => (
            <article
              class="expand-card group w-[300px] flex-shrink-0 md:w-[380px]"
              data-expand-card
              data-slug={project.slug}
              tabindex="0"
              role="button"
              aria-label={`Open ${project.name} details`}
            >
              <button
                class="btn-interactive expand-back-btn flex h-10 w-10 items-center justify-center"
                data-expand-back
                data-expand-ignore
                aria-label="Shrink card"
              >
                <img src="/images/icons/shrink.webp" alt="" width="24" height="24" />
              </button>

              <div class="card-face">
                <div class="hover-border relative aspect-[4/3] w-full overflow-hidden rounded-xl">
                  <img
                    src={project.cardImage ?? project.image}
                    alt={`${project.name} preview`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="mt-3 flex items-baseline gap-3">
                  <h3 class="card-title min-w-0 flex-1 font-display font-semibold text-white transition-colors group-hover:text-accent">
                    {project.name}
                  </h3>
                  <span class="flex-shrink-0 text-sm text-text-muted">{project.period}</span>
                </div>
                <p class="mt-1 text-base text-text-muted">{project.tag}</p>
              </div>

              <div class="stage-media">
                <img
                  src={project.stageImage ?? project.image}
                  alt={`${project.name} preview`}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>

              <div class="card-detail relative flex-1 p-6">
                <span class="text-sm font-semibold uppercase tracking-wide text-accent">
                  {project.tag}
                </span>
                <h3 class="mt-1 font-display text-3xl font-semibold text-white">{project.name}</h3>
                <span class="mt-1 text-sm text-text-muted">{project.period}</span>
                <p class="mt-4 max-w-xl text-base text-text-muted">{project.description}</p>
                <ul class="mt-3 max-w-md list-disc space-y-1 pl-5 text-sm text-text-muted">
                  {project.highlights.map((highlight) => (
                    <li>{highlight}</li>
                  ))}
                </ul>
                <div class="mt-3 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="rounded-full border border-primary-light/20 px-2 py-0.5 text-[11px] text-primary-light">
                      {tag}
                    </span>
                  ))}
                </div>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noreferrer"
                  data-expand-ignore
                  class="text-cta mt-5 text-sm"
                >
                  <span class="hidden md:inline">Visit site</span>
                  <span class="md:hidden">View here</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

