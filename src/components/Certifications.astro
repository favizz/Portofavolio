---
import { certifications } from '../data/certifications';
---

<section id="certification" class="section">
  <div class="flex w-full flex-col">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-accent" data-reveal>
      Certification
    </p>
    <h2 class="reveal section-heading mt-3" data-reveal>
      Credentials that back the practice with recognized standards.
    </h2>

    <div class="cert-list reveal mt-6 flex w-full flex-col" data-reveal>
      {
        certifications.map((cert) => (
          <div class="grid grid-cols-[1fr_auto] items-baseline gap-x-3 gap-y-1 border-b border-primary-light/10 py-4">
            <h3 class="card-title col-start-1 row-start-1 font-display font-semibold text-white">
              {cert.short}
            </h3>
            <span class="col-start-2 row-start-1 text-sm text-text-muted">{cert.date}</span>
            <p class="col-start-1 row-start-2 text-base text-text-muted">{cert.issuer}</p>
            <a
              href={cert.documentUrl}
              target="_blank"
              rel="noreferrer"
              class="text-cta col-start-2 row-start-2 justify-self-end text-sm"
            >
              <span class="hidden md:inline">View here</span>
              <span class="md:hidden" aria-hidden="true">&#8594;</span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
