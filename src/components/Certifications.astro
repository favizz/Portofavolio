---
import { certifications } from '../data/certifications';
---

<section id="certification" class="section">
  <div class="flex w-full flex-col">
    <h2 class="reveal font-display text-6xl font-bold text-accent md:text-7xl" data-reveal>
      Certification
    </h2>
    <p class="reveal mt-5 max-w-2xl text-justify text-2xl text-text-muted md:text-3xl" data-reveal>
      Credentials that back the practice with recognized standards.
    </p>

    <div
      class="cert-grid reveal mt-10 w-full"
      data-reveal
      data-expand-grid
      data-hscroll
      data-expand-section="certification"
    >
      <div data-expand-carousel>
        {
          certifications.map((cert) => (
            <button type="button" class="carousel-item" data-carousel-item data-slug={cert.slug}>
              {cert.short}
            </button>
          ))
        }
      </div>
      <div data-expand-stage></div>
      <div data-expand-default>
        {
          certifications.map((cert, index) => (
            <article
              class="expand-card group w-[340px] flex-shrink-0 md:w-[460px]"
              data-expand-card
              data-slug={cert.slug}
              tabindex="0"
              role="button"
              aria-label={`Open ${cert.name} details`}
            >
              <div class="card-face">
                <div class="glow-border relative aspect-[4/3] w-full overflow-hidden rounded-xl">
                  <img
                    src={cert.image}
                    alt={`${cert.name} emblem`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="mt-3 flex items-baseline gap-3">
                  <span class="font-display text-base font-semibold text-accent/70">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <h3 class="min-w-0 flex-1 font-display text-3xl font-semibold text-white transition-colors group-hover:text-accent">
                    {cert.short}
                  </h3>
                  <span class="text-sm text-text-muted">{cert.date}</span>
                </div>
                <p class="mt-1 pl-8 text-base text-text-muted">{cert.issuer}</p>
              </div>

              <img src={cert.image} alt="" aria-hidden="true" loading="lazy" decoding="async" class="stage-bg-img" />

              <div class="card-detail relative z-10 w-full flex-1 p-6">
                <button
                  class="btn-interactive absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-bg/80 text-lg text-white backdrop-blur"
                  data-expand-back
                  data-expand-ignore
                  aria-label="Return to certifications"
                >
                  <span class="back-arrow-icon" aria-hidden="true"></span>
                </button>

                <span class="text-sm font-semibold uppercase tracking-wide text-accent">
                  Certification
                </span>
                <h3 class="mt-1 max-w-xl font-display text-3xl font-semibold text-white">
                  {cert.name}
                </h3>
                <p class="mt-1 text-sm font-medium text-accent">{cert.issuer}</p>
                <span class="mt-1 text-sm text-text-muted">{cert.date}</span>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cert-grid :global([data-expand-stage] .expand-card) {
    background: color-mix(in srgb, var(--color-primary-deep) 40%, transparent);
    border-radius: 0.75rem;
    overflow: hidden;
    position: relative;
  }
</style>
