---
import { socials } from '../data/socials';
import { facts } from '../data/facts';

const links = [
  { id: 'home', label: 'Home' },
  { id: 'career', label: 'Career' },
  { id: 'technology', label: 'Technology' },
  { id: 'project', label: 'Projects' },
  { id: 'achievement', label: 'Achievement' },
  { id: 'certification', label: 'Certification' },
  { id: 'contact', label: 'Contact' },
];

const year = new Date().getFullYear();
---

<footer class="relative border-t border-primary-light/10 bg-bg/60 px-6 py-12 md:mt-32 md:px-10">
  <div class="mx-auto grid w-full gap-10 text-left sm:grid-cols-2 md:grid-cols-3">
    <div class="reveal" data-reveal>
      <a href="#home" class="font-display text-xl font-bold text-white">{facts.wordmark}</a>
      <p class="mt-3 max-w-sm text-sm text-text-muted">
        {`${facts.bio.prefix} `}
        <span class="desc-emphasis">{facts.bio.emphasis}</span>
        {` ${facts.bio.suffix}`}
      </p>
    </div>

    <div class="reveal" data-reveal>
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Quick Links</h3>
      <ul class="mt-4 flex flex-col gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={`#${link.id}`}
                class="text-sm text-text-muted transition-colors hover:text-white"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal" data-reveal>
      <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-accent">Connect</h3>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          data-mailto-user={facts.email.split('@')[0]}
          data-mailto-domain={facts.email.split('@')[1]}
          aria-label="Email"
          class="btn-interactive flex h-10 w-10 items-center justify-center rounded-full bg-primary-deep text-primary-light hover:text-white"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
            <path d="M1.5 4.5A1.5 1.5 0 0 1 3 3h18a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 21 21H3a1.5 1.5 0 0 1-1.5-1.5v-15Zm2.2.5 8.3 6.4 8.3-6.4H3.7Zm16.8 1.4-8.06 6.22a1.5 1.5 0 0 1-1.88 0L3.5 6.4V18h17V6.4Z" />
          </svg>
        </a>
        {
          socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noreferrer"
              aria-label={social.label}
              class="btn-interactive flex h-10 w-10 items-center justify-center rounded-full bg-primary-deep text-primary-light hover:text-white"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 fill-current">
                <path d={social.path} />
              </svg>
            </a>
          ))
        }
      </div>
      <a
        href={facts.cvUrl}
        target="_blank"
        rel="noreferrer"
        download
        class="btn-interactive mt-4 inline-flex items-center justify-center rounded-lg bg-primary-strong px-5 py-2.5 text-sm font-semibold text-white"
      >
        Download CV
      </a>
    </div>
  </div>

  <div
    class="mx-auto mt-10 flex w-full flex-col items-center gap-2 border-t border-primary-light/10 pt-6 text-center text-xs text-text-muted sm:flex-row sm:justify-between sm:text-left"
  >
    <p>&copy; {year} {facts.displayName}. All rights reserved.</p>
    <p>Designed and developed by {facts.fullName}.</p>
  </div>
</footer>
