---
import { experience } from '../data/experience';
import { findRelatedProjectForJob } from '../data/relations';

const MONTHS: Record<string, number> = {
  Jan: 1, Feb: 2, Mar: 3, Apr: 4, May: 5, Jun: 6,
  Jul: 7, Aug: 8, Sep: 9, Oct: 10, Nov: 11, Dec: 12,
};

// Cards are ordered by when each one ENDED, newest first, not by manual
// placement, so a new entry always lands in the right spot without needing
// to be re-sorted by hand. A bare year with no month (shouldn't happen in
// current data, every period has an explicit month) falls back to
// December of that year, the most conservative "still ongoing" reading.
function parseEndDate(period: string): number {
  const end = (period.split(' - ')[1] ?? period).trim();
  const match = end.match(/^([A-Za-z]{3})\s+(\d{4})$/);
  if (match) {
    return parseInt(match[2], 10) * 12 + MONTHS[match[1]];
  }
  return parseInt(end, 10) * 12 + 12;
}

const sortedExperience = [...experience].sort(
  (a, b) => parseEndDate(b.period) - parseEndDate(a.period)
);
---

<section id="career" class="section">
  <div class="relative z-10 w-full">
    <div class="flex flex-col">
      <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-accent" data-reveal>
        Career
      </p>
      <h2 class="reveal section-heading mt-3" data-reveal>
        The people and places that shaped how I build software.
      </h2>
    </div>

    <div
      class="reveal mt-4 w-full"
      data-reveal
      data-expand-grid
      data-hscroll
      data-expand-section="career"
    >
      <div data-expand-carousel>
        {
          sortedExperience.map((job) => (
            <button type="button" class="carousel-item" data-carousel-item data-slug={job.slug}>
              {job.short}
            </button>
          ))
        }
      </div>
      <div class="carousel-nav-mobile" data-carousel-nav>
        <button type="button" class="carousel-nav-btn" data-carousel-prev aria-label="Previous role">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 5 8 12l7 7" fill="none" stroke="black" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15 5 8 12l7 7" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="carousel-nav-btn" data-carousel-next aria-label="Next role">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 5l7 7-7 7" fill="none" stroke="black" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M9 5l7 7-7 7" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
      <div data-expand-default>
        {
          sortedExperience.map((job) => {
            const related = findRelatedProjectForJob(job);
            return (
              <article
                class="expand-card group w-[300px] flex-shrink-0"
                data-expand-card
                data-slug={job.slug}
                tabindex="0"
                role="button"
                aria-label={`Open ${job.company} details`}
              >
                <button
                  class="btn-interactive expand-back-btn flex h-10 w-10 items-center justify-center"
                  data-expand-back
                  data-expand-ignore
                  aria-label="Shrink card"
                >
                  <img src="/images/icons/shrink.webp" alt="" width="24" height="24" />
                </button>

                <div class="card-face">
                  <div class="hover-border relative aspect-[4/3] w-full overflow-hidden rounded-xl">
                    <img
                      src={job.cardImage ?? '/images/placeholders/expand.webp'}
                      alt={`${job.company} visual`}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                    <span class="absolute bottom-1 right-1 flex h-16 w-16 items-center justify-center rounded-xl bg-white p-2 shadow-lg">
                      <img
                        src={job.logo}
                        alt={`${job.company} logo`}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full rounded-lg object-contain"
                      />
                    </span>
                  </div>
                  <div class="mt-2 flex items-baseline gap-3">
                    <h3 class="card-title min-w-0 flex-1 font-display font-semibold text-white transition-colors group-hover:text-accent">
                      {job.shortRole ?? job.role}
                    </h3>
                    <span class="flex-shrink-0 text-sm text-text-muted">{job.period}</span>
                  </div>
                  <p class="mt-1 text-base text-text-muted">{job.short}</p>
                  {/* Mobile's collapsed row hides the paragraph above
                      entirely (see [data-expand-default] .card-face > p in
                      global.css, shared with Projects), leaving just
                      title + date with no company name at all. This is a
                      SEPARATE, mobile-only line rather than un-hiding that
                      one, so Projects' own collapsed row (never asked to
                      show a second line) isn't affected by the same rule. */}
                  <p class="mt-1 text-sm text-text-muted md:hidden">{job.company}</p>
                </div>

                <div class="stage-media">
                  {/* Mobile uses the same card-face ("Fr") photo as the
                      collapsed view instead of the dedicated stage ("In")
                      photo, per explicit instruction. Two <img> tags
                      swapped by breakpoint rather than one src, since
                      Astro/CSS has no way to pick a different bitmap per
                      media query on a single <img>. */}
                  <img
                    src={job.stageImage ?? job.logo}
                    alt={`${job.company} visual`}
                    loading="lazy"
                    decoding="async"
                    class="hidden h-full w-full object-cover md:block"
                  />
                  <img
                    src={job.cardImage ?? job.logo}
                    alt={`${job.company} visual`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover md:hidden"
                  />
                </div>

                <div class="card-detail relative z-10 w-full flex-1 p-6">
                  <h3 class="font-display text-3xl font-semibold text-white">
                    {job.role}
                    {job.employmentTag && (
                      <span class="ml-2 align-middle rounded-full bg-primary-deep px-2.5 py-1 text-xs font-medium tracking-wide text-text-muted">
                        {job.employmentTag}
                      </span>
                    )}
                  </h3>
                  <p class="mt-1 text-sm font-medium">
                    <span class="text-accent">{job.company}</span>
                    {job.team && <span class="text-text-muted"> - {job.team}</span>}
                  </p>
                  <p class="mt-1 text-[11px] font-normal text-text-muted/60">({job.companyNote})</p>
                  <span class="mt-1 text-sm text-text-muted">{job.period}</span>

                  <ul class="mt-3 max-w-xl list-disc space-y-1 pl-5 text-base text-text-muted">
                    {job.bullets.map((bullet) => (
                      <li set:html={bullet} />
                    ))}
                  </ul>

                  {related && (
                    <p class="mt-5 text-sm">
                      <span class="font-semibold uppercase tracking-wide text-text-muted">
                        Related project:
                      </span>{' '}
                      <button
                        type="button"
                        data-expand-ignore
                        data-open-section="project"
                        data-open-slug={related.slug}
                        class="text-cta cursor-pointer"
                      >
                        {related.name}
                      </button>
                    </p>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

