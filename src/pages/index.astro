---
import Layout from '../layouts/Layout.astro';
import GradientField from '../components/GradientField.astro';
import Header from '../components/Header.astro';
import SideNav from '../components/SideNav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Academic from '../components/Academic.astro';
import Certifications from '../components/Certifications.astro';
import Projects from '../components/Projects.astro';
import Technology from '../components/Technology.astro';
import Career from '../components/Career.astro';
import Achievements from '../components/Achievements.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <GradientField />
  <Header />
  <SideNav />

  <main>
    <Hero />
    <About />
    <Academic />
    <Certifications />
    <Projects />
    <Technology />
    <Career />
    <Achievements />
    <Contact />
  </main>

  <Footer />

  <script>
    import '../scripts/motion.ts';
  </script>
</Layout>
